# 실시간 AI 코스 생성에는 TourAPI·OpenAI·Kakao REST 키가 필요합니다.
# 키 없이도 준비된 코스 둘러보기/주행 시뮬레이션/영상 기록/외부 음악 앱 열기는 가능합니다.
# 이 파일을 .env로 복사한 후 서버에서만 키를 설정하세요.
KAKAO_REST_API_KEY=
# 지도 SDK 전용 JavaScript 키. /api/map-config를 통해 브라우저/WebView에 공개됩니다.
# REST API 키와 다릅니다. Kakao Developers에 사용할 웹 도메인을 등록하세요.
KAKAO_MAP_JS_KEY=
TOUR_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
PORT=4173
# 기본 바인딩은 127.0.0.1. 공개 배포 시 별도 인증/HTTPS/요청 제한 설계 필요.
