#!/bin/sh
set -eu
PROJECT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# Keep this project's dependency cache independent of existing user settings.
GRADLE_USER_HOME=${GRADLE_USER_HOME:-"$PROJECT_DIR/.gradle-home"}
export GRADLE_USER_HOME
if [ -n "${JAVA_HOME:-}" ]; then
    JAVA_BIN="$JAVA_HOME/bin/java"
elif [ -x '/Applications/Android Studio.app/Contents/jbr/Contents/Home/bin/java' ]; then
    JAVA_BIN='/Applications/Android Studio.app/Contents/jbr/Contents/Home/bin/java'
else
    JAVA_BIN=java
fi
exec "$JAVA_BIN" -classpath "$PROJECT_DIR/gradle/wrapper/gradle-wrapper.jar" org.gradle.wrapper.GradleWrapperMain "$@"
